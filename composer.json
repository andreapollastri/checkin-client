{
    "name": "andreapollastri/checkin-client",
    "description": "Single sign-on client for Laravel applications — log in with Checkin (OpenID Connect), with an optional Filament login button.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "sso",
        "oidc",
        "openid-connect",
        "oauth2",
        "filament",
        "checkin",
        "iam"
    ],
    "homepage": "https://github.com/andreapollastri/checkin-client",
    "authors": [
        {
            "name": "Andrea Pollastri",
            "homepage": "https://andreapollastri.net",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/andreapollastri/checkin-client/issues",
        "source": "https://github.com/andreapollastri/checkin-client",
        "docs": "https://github.com/andreapollastri/checkin-client#readme"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^6.10 || ^7.0",
        "illuminate/auth": "^11.0 || ^12.0 || ^13.0",
        "illuminate/cache": "^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/events": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/session": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/view": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0"
    },
    "suggest": {
        "filament/filament": "Adds a \"Continue with Checkin\" button to Filament panel login pages via Checkin\\Filament\\CheckinPlugin (^4.0 || ^5.0)."
    },
    "autoload": {
        "psr-4": {
            "Checkin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Checkin\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Checkin\\CheckinServiceProvider"
            ],
            "aliases": {
                "Checkin": "Checkin\\Facade"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint",
        "lint:check": "pint --test"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
